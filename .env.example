# Copy to .env and adjust. Every line is optional.

# Port the app is served on.
WEB_PORT=8080

# Database password (only used inside the Docker network).
DB_PASSWORD=routeplanner

# Load a map automatically on first start. You can also do this later in Settings.
# DEFAULT_REGION_NAME=Ohio
# DEFAULT_REGION_URL=https://download.geofabrik.de/north-america/us/ohio-latest.osm.pbf

# Sent to the public address lookup services so they can identify the app.
# GEOCODER_USER_AGENT=route-planner (you@example.org)

# Optional API keys for a paid address lookup. You can also paste these in the app under
# Settings -> Address lookup instead. After adding one, choose that service in Settings.
# GOOGLE_MAPS_API_KEY=
# MAPBOX_ACCESS_TOKEN=
# GEOCODIO_API_KEY=

# Where the daily backup files are written on this computer (default: a "backups" folder
# next to docker-compose.yml), and how many days to keep.
# BACKUP_FOLDER=D:/RoutePlannerBackups
# BACKUP_KEEP=30

# Time zone for the app's clock (default: US Eastern).
# TZ=America/Chicago
